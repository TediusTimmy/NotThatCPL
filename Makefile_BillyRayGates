# Makefile for NotThatCPL interpreter : Centurion Programming Language
# Billy Ray Gates version. Say what you will about the womanizing asshat,
# Microsoft had better products when he was in charge (comparatively).

CCP := x86_64-w64-mingw32-g++

CFLAGS += -Wall -Wextra -Wpedantic -DNOTTHATCPL_NATIVE_WINDOWS -DNOTTHATCPL_WITH_DEBUGGING

ifeq "$(MAKECMDGOALS)" "debug"
   CFLAGS += -O0 -g
   BFLAGS += -static
else
   CFLAGS += -O2
   BFLAGS += -s -static
endif

.PHONY: all clean release debug
all: bin/CPL.exe


clean:
	rm bin/CPL.exe | true
	rm -rf obj/*.obj | true

release: all


debug: all


bin/CPL.exe: obj/CPL.obj obj/Screen.obj obj/SigInt.obj obj/Compiler.obj obj/Execution.obj | bin
	$(CCP) $(CFLAGS) $(BFLAGS) -o bin/CPL.exe obj/*.obj

obj/CPL.obj: NotThatCPL.cpp | obj
	$(CCP) $(CFLAGS) -c -o obj/CPL.obj NotThatCPL.cpp

obj/Screen.obj: Screen.cpp | obj
	$(CCP) $(CFLAGS) -c -o obj/Screen.obj Screen.cpp

obj/SigInt.obj: SigInt.cpp | obj
	$(CCP) $(CFLAGS) -c -o obj/SigInt.obj SigInt.cpp

obj/Compiler.obj: Compiler.cpp | obj
	$(CCP) $(CFLAGS) -c -o obj/Compiler.obj Compiler.cpp

obj/Execution.obj: Execution.cpp | obj
	$(CCP) $(CFLAGS) -c -o obj/Execution.obj Execution.cpp

bin:
	mkdir bin

obj:
	mkdir obj
